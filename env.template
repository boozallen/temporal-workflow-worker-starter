# Temporal Configuration
# Use host.docker.internal:7233 to connect to external Temporal server from Docker.
# `just dev` runs the worker on the host and uses localhost:7233 instead, unless
# TEMPORAL_HOST is set in your shell.
TEMPORAL_HOST=host.docker.internal:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=workflow-task-queue

# Worker Configuration
WORKER_IDENTITY=worker-1

# Temporal TLS posture (required; defaults to "platform")
#   platform - TLS is terminated by the deployment platform / service mesh.
#              The worker itself connects over plaintext gRPC — only correct
#              when the mesh actually encrypts the hop.
#   tls      - Application-managed one-way TLS. Verifies the server using
#              system root CAs, or TEMPORAL_TLS_CA when set.
#   mtls     - Application-managed mutual TLS. Requires TEMPORAL_TLS_CERT
#              and TEMPORAL_TLS_KEY.
# Set this explicitly for every deployed environment to match its real transport.
TEMPORAL_TLS_MODE=platform

# Certificate material for TEMPORAL_TLS_MODE=tls or mtls (paths to PEM files).
# TEMPORAL_TLS_CERT and TEMPORAL_TLS_KEY must be set together.
#TEMPORAL_TLS_CERT=/certs/client.pem
#TEMPORAL_TLS_KEY=/certs/client.key
#TEMPORAL_TLS_CA=/certs/ca.pem

# Engine client authentication (required)
# TEMPORAL_TLS_MODE controls transport encryption, not client identity: under
# "platform", TLS is terminated by the mesh and the Temporal server cannot
# distinguish callers by certificate. The worker therefore requires one of the
# two mechanisms below so that namespace reachability alone cannot deliver
# signals. Set exactly one:
#   1. Mutual TLS — set TEMPORAL_TLS_CERT and TEMPORAL_TLS_KEY above (also
#      requires TEMPORAL_TLS_MODE=mtls to encrypt the transport with them), or
#   2. OAuth2 client-credentials bearer token — set the three variables below.
# Without real settings here, the worker refuses to start. For local development
# only, `just dev`, `just validate-docker` and `docker compose up` fall back to
# placeholder mTLS paths that are never read under "platform". See dev.env.
#TEMPORAL_AUTH_TOKEN_URL=https://auth.example.com/oauth2/token
#TEMPORAL_AUTH_CLIENT_ID=your-client-id
#TEMPORAL_AUTH_CLIENT_SECRET=your-client-secret
#TEMPORAL_AUTH_SCOPES=openid

# Agent client (foundry-temporal-agents, used by the call_strands_agent activity)
# Bearer token sent to the agent service. Set it to the same value as the
# agent's STRANDS_API_KEY. The mock agent does not check it,
# but a deployed agent usually does. When unset, requests go out
# unauthenticated and the worker logs a warning; a future release of
# foundry-temporal-agents will make that an error.
#FOUNDRY_AGENT_BEARER_TOKEN=your-agent-token
#
# TLS posture for agent calls, separate from TEMPORAL_TLS_MODE (defaults to
# "platform"). Accepts platform, tls or mtls. mtls requires both
# FOUNDRY_TLS_CLIENT_CERTFILE and FOUNDRY_TLS_CLIENT_KEYFILE. A bad value fails
# each agent call at runtime, not at worker startup.
#FOUNDRY_TLS_MODE=platform
#FOUNDRY_TLS_CLIENT_CERTFILE=/certs/agent-client.pem
#FOUNDRY_TLS_CLIENT_KEYFILE=/certs/agent-client.key
#FOUNDRY_TLS_CA_CERTFILE=/certs/agent-ca.pem
