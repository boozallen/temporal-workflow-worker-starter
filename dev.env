# Local development only. Never deploy with these values.
#
# `just dev` and `just validate-docker` load this file as fallback defaults.
# For `just dev`, values in `.env` win over this file, and values set in your
# shell win over both. Deployed environments never load this file, so they must
# supply real mTLS or OAuth2 settings (see env.template) or the worker refuses
# to start.
#
# Because these placeholders always satisfy the startup auth check, a broken
# OAuth2 setup in `.env` is not caught when this file is loaded.

# The local Temporal dev server is plaintext, so no application TLS is used.
TEMPORAL_TLS_MODE=platform

# Engine client authentication placeholders. Startup requires an auth
# mechanism, but under "platform" mode these paths are never read, so no real
# certificate material is needed locally.
TEMPORAL_TLS_CERT=/dev-placeholder/client.pem
TEMPORAL_TLS_KEY=/dev-placeholder/client.key
